<wxs module="utils">
    var join = function(a,b) {
        return a+b
    };
    var isNotSlot = function(v) {
        return typeof v !== 'string'
    }
    module.exports = {
        join: join,
        isNotSlot: isNotSlot
    }
</wxs><view wx:if="{{mask}}" class="weui-mask {{show?'':'weui-mask_hidden'}} {{maskClass}}" bindtap="closeActionSheet"/><view class="weui-actionsheet {{show?'weui-actionsheet_toggle':''}} {{extClass}}"><view wx:if="{{title}}" class="weui-actionsheet__title"><view class="weui-actionsheet__title-text">{{title}}</view></view><slot wx:else name="title"/><view wx:for="{{actions}}" wx:for-item="actionItem" wx:key="index" class="{{!showCancel&&index===actions.length-1?'weui-actionsheet__action':'weui-actionsheet__menu'}}"><block wx:if="{{utils.isNotSlot(actionItem)}}"><view wx:for="{{actionItem}}" wx:for-index="actionIndex" wx:key="actionIndex" class="weui-actionsheet__cell {{item.type==='warn'?'weui-actionsheet__cell_warn':''}}" bindtap="buttonTap" data-groupindex="{{index}}" data-index="{{actionIndex}}" data-value="{{item.value}}">
                {{item.text}}
            </view></block><slot wx:else name="{{actionItem}}"/></view><view wx:if="{{showCancel}}" class="weui-actionsheet__action"><view class="weui-actionsheet__cell" bindtap="closeActionSheet" id="iosActionsheetCancel" data-type="close">{{cancelText}}</view></view></view>
